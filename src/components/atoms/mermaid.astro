---
import { Code } from "astro:components"

interface Props {
  code: string
}
const { code } = Astro.props
---

<figure class="mermaid-figure" data-view="preview">
  <pre class="mermaid">{code}</pre>
  <div class="mermaid-source">
    {/* ponytail: tokenized as TS, not mermaid — Shiki has no C4 grammar, and
        C4's Component(...)/Rel(...) syntax colorizes cleanly as function calls. */}
    <Code code={code.trim()} lang="typescript" theme="github-dark" />
  </div>

  <div class="mermaid-toggle" role="group" aria-label="Diagram view">
    <button type="button" data-view="code">Code</button>
    <button type="button" data-view="preview" aria-pressed="true">Preview</button>
  </div>
</figure>

<script>
  // ponytail: mermaid is client-only; Astro bundles + dedupes this module
  // script, so it runs once no matter how many diagrams are on the page.
  import mermaid from "mermaid"
  import panzoom from "panzoom"

  mermaid.initialize({ startOnLoad: false })
  await mermaid.run()

  // Make each rendered diagram pan/zoomable. Wrap the SVG in a viewport div and
  // pan/zoom that via CSS transform, so we never fight mermaid's own SVG transforms.
  document.querySelectorAll<HTMLElement>(".mermaid").forEach((container) => {
    const svg = container.querySelector("svg")
    if (!svg) return
    const viewport = document.createElement("div")
    viewport.className = "mermaid-viewport"
    svg.replaceWith(viewport)
    viewport.appendChild(svg)
    // Override mermaid's natural-width cap so the diagram fills the column width.
    svg.style.maxWidth = "none"
    svg.style.width = "100%"
    svg.style.height = "auto"
    // No bounds: bounds-clamping shifts the view after a zoom and breaks cursor
    // anchoring. Double-click resets to the initial full-width fit instead.
    const pz = panzoom(viewport, { maxZoom: 5, minZoom: 0.5, zoomDoubleClickSpeed: 1 })
    viewport.addEventListener("dblclick", () => {
      pz.zoomAbs(0, 0, 1)
      pz.moveTo(0, 0)
    })
  })

  // Wire the Code/Preview toggle for every diagram on the page.
  document.querySelectorAll<HTMLElement>(".mermaid-figure").forEach((figure) => {
    const buttons = figure.querySelectorAll<HTMLButtonElement>(".mermaid-toggle button")
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        figure.dataset.view = button.dataset.view
        buttons.forEach(b => b.setAttribute("aria-pressed", String(b === button)))
      })
    })
  })
</script>

<style>
  .mermaid-figure {
    position: relative;
    margin: 0;
    padding-top: 2.5rem;
  }

  .mermaid {
    background: none;
    overflow: hidden; /* clip the diagram as it pans/zooms within the frame */
  }

  .mermaid-viewport {
    width: 100%; /* fill the column so the diagram maximizes visible width */
    cursor: grab;
    touch-action: none; /* let panzoom own touch gestures (pinch/drag) */
  }
  .mermaid-viewport:active {
    cursor: grabbing;
  }

  .mermaid-source {
    overflow-x: auto;
  }

  /* Show one view at a time. */
  .mermaid-figure[data-view="preview"] .mermaid-source {
    display: none;
  }
  .mermaid-figure[data-view="code"] .mermaid {
    display: none;
  }

  .mermaid-toggle {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 0.375rem;
    overflow: hidden;
    font-size: 0.75rem;
  }

  .mermaid-toggle button {
    padding: 0.2rem 0.6rem;
    border: 0;
    background: none;
    color: inherit;
    opacity: 0.55;
    cursor: pointer;
    font: inherit;
  }

  .mermaid-toggle button[aria-pressed="true"] {
    background: color-mix(in srgb, currentColor 12%, transparent);
    opacity: 1;
  }
</style>
