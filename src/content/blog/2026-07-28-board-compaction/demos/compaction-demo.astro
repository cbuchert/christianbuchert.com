---
// Interactive compaction board. Click a chip to remove it (models a merge /
// completion) and watch the chosen strategy recompact. Live metrics below.
// strategy covers demos A–D: corner | wrap | brick | mirror | down.
interface Props {
  strategy?: "corner" | "wrap" | "brick" | "mirror" | "down"
  side?: number
  caption?: string
}
const { strategy = "corner", side = 6, caption } = Astro.props
---

<figure class="compaction-demo" data-strategy={strategy} data-side={side}>
  <div class="demo-board" aria-label="compaction board"></div>
  <p class="demo-metrics" aria-live="polite"></p>
  <div class="demo-controls">
    <button type="button" class="demo-reset">Reset</button>
    {caption && <figcaption>{caption}</figcaption>}
  </div>
</figure>

<script>
  import {
    colOf,
    compactBrick,
    compactCorner,
    compactDown,
    compactMirrorDown,
    compactWrap,
    countChipsMoved,
    elongation,
    fullGrid,
    originEdgeLoad,
    rowOf,
    settleJitter,
    type Board,
  } from "./compaction"

  const strategies = {
    corner: compactCorner,
    wrap: compactWrap,
    brick: compactBrick,
    mirror: compactMirrorDown,
    down: compactDown,
  }

  document.querySelectorAll<HTMLElement>(".compaction-demo").forEach((root) => {
    const compact = strategies[root.dataset.strategy as keyof typeof strategies] ?? compactCorner
    const side = Number(root.dataset.side ?? 6)
    const boardEl = root.querySelector<HTMLElement>(".demo-board")!
    const metricsEl = root.querySelector<HTMLElement>(".demo-metrics")!

    let board = compact(fullGrid(side))

    function render(moved: number) {
      const cells = [...board.keys()]
      boardEl.style.setProperty("--cols", String(Math.max(0, ...cells.map(colOf)) + 1))
      boardEl.replaceChildren()
      for (const [cell, id] of board) {
        const chip = document.createElement("button")
        chip.className = "chip"
        chip.style.gridColumn = String(colOf(cell) + 1)
        chip.style.gridRow = String(rowOf(cell) + 1)
        // ponytail: hue from stack id so a chip keeps its color as it slides —
        // makes "chips moved" legible to the eye, not just the metric.
        chip.style.background = `hsl(${(id * 47) % 360} 55% 82%)`
        chip.textContent = String(id)
        chip.title = `stack ${id} — click to remove`
        chip.addEventListener("click", () => remove(id))
        boardEl.appendChild(chip)
      }
      metricsEl.textContent
        = `moved ${moved}  ·  elongation ${elongation(board).toFixed(2)}`
        + `  ·  originLoad ${originEdgeLoad(board).toFixed(2)}`
        + `  ·  settle-jitter ${settleJitter(compact, board)}`
    }

    function remove(id: number) {
      const next: Board = new Map(board)
      for (const [cell, sid] of next)
        if (sid === id) {
          next.delete(cell)
          break
        }
      const prev = board
      board = compact(next)
      render(countChipsMoved(prev, board))
    }

    root.querySelector(".demo-reset")?.addEventListener("click", () => {
      board = compact(fullGrid(side))
      render(0)
    })

    render(0)
  })
</script>

<style>
  .compaction-demo {
    margin: 1.5rem 0;
  }
  .demo-board {
    display: grid;
    grid-template-columns: repeat(var(--cols, 6), 1fr);
    grid-auto-rows: 2rem;
    gap: 3px;
    width: min(100%, calc(var(--cols, 6) * 2.3rem));
  }
  .chip {
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    border-radius: 4px;
    color: #1f2733;
    font-size: 0.7rem;
    cursor: pointer;
    transition: opacity 0.1s;
  }
  .chip:hover {
    opacity: 0.6;
  }
  .demo-metrics {
    margin: 0.6rem 0 0.4rem;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }
  .demo-controls {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .demo-reset {
    padding: 0.2rem 0.7rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 0.375rem;
    background: color-mix(in srgb, currentColor 6%, transparent);
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
  }
  .demo-reset:hover {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }
  figcaption {
    font-size: 0.8rem;
    opacity: 0.6;
  }
</style>
